{
  "name": "ke-dem-audio",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "none", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "audio_db", "database_id": "REPLACE_ME", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "ke-dem-media" }],
  "vars": { "MEDIA_PUBLIC_BASE": "" }
}
