{
  "name": "ke-dem-audio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "db:migrate:local": "wrangler d1 migrations apply audio_db --local",
    "db:seed:local": "node scripts/seed-local.mjs",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test tests/",
    "test:api": "node --test tests/api.test.mjs",
    "test:logic": "node --test tests/logic.test.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "hls.js": "^1.7.4",
    "hono": "^4.13.18",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^6.4.6",
    "wrangler": "^4.158.0"
  }
}
