{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "ESNext", "moduleResolution": "bundler", "types": ["@cloudflare/workers-types"],
    "strict": true, "skipLibCheck": true, "noEmit": true, "isolatedModules": true,
    "paths": { "@shared/*": ["./shared/*"] }, "composite": true, "tsBuildInfoFile": "node_modules/.tmp/worker.tsbuildinfo"
  },
  "include": ["worker/src", "shared"]
}
